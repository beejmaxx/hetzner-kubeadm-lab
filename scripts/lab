#!/usr/bin/env python3
"""Explicit stages: Terraform infrastructure, SSH bootstrap, optional demo."""
import argparse
import json
import os
from pathlib import Path
import shlex
import subprocess
import sys
import time

ROOT = Path(__file__).resolve().parents[1]
TF = ROOT / "scripts/terraform-lab"
HCLOUD = ROOT / "scripts/hcloud-lab"
LOCAL = ROOT / ".lab"
NAMES = ("k8s-cp", "k8s-worker1", "k8s-worker2")


def run(args, *, capture=False, input=None, check=True):
    return subprocess.run([str(a) for a in args], text=True, input=input,
                          stdout=subprocess.PIPE if capture else None,
                          check=check)


def tf(*args, **kwargs):
    return run([TF, *args], **kwargs)


def cloud(kind):
    return json.loads(run([HCLOUD, kind, "list", "-o", "json"], capture=True).stdout)


def tracked_resources():
    if not (ROOT / "terraform/terraform.tfstate").exists():
        return set()
    return set(tf("state", "list", capture=True).stdout.splitlines())


def inventory():
    nodes = json.loads(tf("output", "-json", "nodes", capture=True).stdout)
    if set(nodes) != set(NAMES):
        sys.exit("Expected the three lab nodes in Terraform outputs; import or apply first.")
    # Never allow a stale state/output to direct bootstrap into a recycled IP.
    live = {str(s["id"]): s for s in cloud("server")}
    for name, node in nodes.items():
        server = live.get(str(node["id"]))
        if (not server or server["name"] != name
                or server["labels"].get("purpose") != "k8s-lab"
                or server["public_net"]["ipv4"]["ip"] != node["public_ip"]
                or not any(n["ip"] == node["private_ip"] for n in server["private_net"])):
            sys.exit(f"Terraform/live lab inventory mismatch for {name}; run plan first.")
    return nodes


def ssh_command(name, nodes):
    node = nodes[name]
    # A new server ID gets its own host-key identity; never erase old host keys.
    return ["ssh", "-F", "/dev/null", "-i", str(Path.home()/".ssh/id_ed25519"),
            "-o", "IdentitiesOnly=yes", "-o", "BatchMode=yes",
            "-o", "ConnectTimeout=10", "-o", "ServerAliveInterval=15",
            "-o", "ServerAliveCountMax=4", "-o", "StrictHostKeyChecking=accept-new",
            "-o", f"UserKnownHostsFile={LOCAL / 'known_hosts'}",
            "-o", f"HostKeyAlias=lab-{node['id']}", f"root@{node['public_ip']}"]


def remote(name, nodes, command, **kwargs):
    return run([*ssh_command(name, nodes), command], **kwargs)


def upload(name, nodes, source, destination):
    remote(name, nodes, f"umask 077; cat > {shlex.quote(destination)}",
           input=source.read_text())


def configure_ssh(nodes):
    text = "# Generated by scripts/lab ssh-config. Public IPs change on rebuild.\n"
    for name in NAMES:
        node = nodes[name]
        text += (f"Host {name}\n    HostName {node['public_ip']}\n    User root\n"
                 "    IdentityFile ~/.ssh/id_ed25519\n    IdentitiesOnly yes\n"
                 f"    UserKnownHostsFile {LOCAL / 'known_hosts'}\n"
                 f"    HostKeyAlias lab-{node['id']}\n"
                 "    StrictHostKeyChecking accept-new\n    ServerAliveInterval 30\n\n")
    (ROOT / "hetzner").mkdir(exist_ok=True)
    (ROOT / "hetzner/ssh_config").write_text(text)
    print("Updated hetzner/ssh_config. Connect with ssh -F hetzner/ssh_config k8s-cp.")


def adopt():
    """Imports affect local state only. Never auto-apply after importing."""
    tf("init", "-input=false")
    servers = {s["name"]: s for s in cloud("server")}
    networks = [n for n in cloud("network") if n["name"] == "lab-k8s"]
    firewalls = [f for f in cloud("firewall") if f["name"] == "lab-k8s"]
    if len(networks) != 1 or len(firewalls) != 1 or not set(NAMES) <= servers.keys():
        sys.exit("Existing lab incomplete: cannot import automatically.")
    net, fw = networks[0], firewalls[0]
    if net["ip_range"] != "10.110.0.0/16":
        sys.exit("Unexpected network range; refusing import.")
    for obj in [net, fw, *(servers[n] for n in NAMES)]:
        if obj["labels"].get("purpose") != "k8s-lab":
            sys.exit("Resource missing purpose=k8s-lab; refusing import.")
    imports = [("hcloud_network.lab", str(net["id"])),
               ("hcloud_network_subnet.lab", f"{net['id']}-10.110.0.0/24"),
               ("hcloud_firewall.lab", str(fw["id"]))]
    imports += [(f'hcloud_server.node["{n}"]', str(servers[n]["id"])) for n in NAMES]
    existing = tracked_resources()
    for address, resource_id in imports:
        if address not in existing:
            tf("import", "-input=false", address, resource_id)
    # Save refreshed outputs without performing any cloud changes.
    tf("apply", "-refresh-only", "-auto-approve", "-input=false")
    tf("plan", "-input=false")


def bootstrap(nodes):
    for name in NAMES:
        print(f"[{name}] Waiting for SSH and cloud-init", flush=True)
        deadline = time.monotonic() + 300
        while remote(name, nodes, "true", check=False, capture=True).returncode:
            if time.monotonic() > deadline:
                sys.exit(f"SSH did not become available on {name}")
            time.sleep(5)
        remote(name, nodes, "timeout 300 cloud-init status --wait")
        upload(name, nodes, ROOT / "bootstrap/prepare-node.sh", "/root/prepare-node.sh")
        remote(name, nodes, f"bash /root/prepare-node.sh {shlex.quote(nodes[name]['private_ip'])}")
    cp = "k8s-cp"
    upload(cp, nodes, ROOT / "bootstrap/kubeadm-init.yaml", "/root/kubeadm-init.yaml")
    remote(cp, nodes, """set -eu
if [ ! -f /etc/kubernetes/admin.conf ]; then
  kubeadm init --config /root/kubeadm-init.yaml --skip-token-print
fi
install -d -m 700 /root/.kube
install -m 600 /etc/kubernetes/admin.conf /root/.kube/config
kubectl get --raw=/readyz
""")
    upload(cp, nodes, ROOT / "bootstrap/calico-installation.yaml", "/root/calico-installation.yaml")
    remote(cp, nodes, """set -eu
base=https://raw.githubusercontent.com/projectcalico/calico/v3.33.0/manifests
curl --retry 3 -fsSL "$base/v3_projectcalico_org.yaml" -o /root/calico-crds.yaml
curl --retry 3 -fsSL "$base/tigera-operator.yaml" -o /root/tigera-operator.yaml
kubectl apply --server-side -f /root/calico-crds.yaml
kubectl apply --server-side -f /root/tigera-operator.yaml
kubectl wait --for=condition=Established crd/installations.operator.tigera.io --timeout=120s
kubectl rollout status deployment/tigera-operator -n tigera-operator --timeout=300s
kubectl apply -f /root/calico-installation.yaml
""")
    # Short-lived token kept in memory and sent over SSH stdin, not argv or files.
    join = remote(cp, nodes, "kubeadm token create --ttl 15m --print-join-command", capture=True).stdout.strip()
    if not join.startswith("kubeadm join 10.110.0.2:6443 "):
        sys.exit("Unexpected join endpoint; refusing to join workers.")
    for name in NAMES[1:]:
        remote(name, nodes, "bash -se", input=(
            "if [ ! -f /etc/kubernetes/kubelet.conf ]; then\n"
            + join + " --cri-socket unix:///run/containerd/containerd.sock\nfi\n"))
    remote(cp, nodes, """set -eu
kubectl wait --for=condition=Ready node/k8s-cp node/k8s-worker1 node/k8s-worker2 --timeout=600s
kubectl rollout status deployment/coredns -n kube-system --timeout=300s
kubectl rollout status daemonset/calico-node -n calico-system --timeout=300s
kubectl wait --for=condition=Available tigerastatus/calico --timeout=300s
kubectl get nodes -o wide
kubectl get tigerastatus
""")


def demo(nodes):
    cp = "k8s-cp"
    # Explicit optional demo: replacing only these named lab Pods is intentional.
    remote(cp, nodes, "KUBECONFIG=/etc/kubernetes/admin.conf kubectl delete pod web client -n network-lab --ignore-not-found")
    upload(cp, nodes, ROOT / "bootstrap/demo.yaml", "/root/network-lab.yaml")
    remote(cp, nodes, """set -eu
export KUBECONFIG=/etc/kubernetes/admin.conf
kubectl apply -f /root/network-lab.yaml
kubectl rollout status deployment/web -n network-lab --timeout=300s
kubectl wait --for=condition=Ready pod/client -n network-lab --timeout=300s
kubectl get pods -n network-lab -o wide
pod_ip=$(kubectl get pod -n network-lab -l app=web -o jsonpath='{.items[0].status.podIP}')
kubectl exec -n network-lab client -- wget -T 5 -qO- "http://$pod_ip"
kubectl exec -n network-lab client -- nslookup web.network-lab.svc.cluster.local
kubectl exec -n network-lab client -- wget -T 5 -qO- http://web
""")


def policy_test(nodes):
    cp = "k8s-cp"
    upload(cp, nodes, ROOT / "bootstrap/deny-web.yaml", "/root/deny-web.yaml")
    remote(cp, nodes, """bash -se <<'SCRIPT'
export KUBECONFIG=/etc/kubernetes/admin.conf
probe() { kubectl exec -n network-lab client -- wget -T 5 -qO- http://web; }
probe >/dev/null
trap 'kubectl delete -f /root/deny-web.yaml --ignore-not-found' EXIT
kubectl apply -f /root/deny-web.yaml
sleep 5
# Require the expected timeout, not just any kubectl/exec failure.
if output=$(probe 2>&1); then
  echo 'FAIL: traffic still allowed'; exit 1
fi
printf '%s\n' "$output" | grep -q 'timed out'
kubectl wait --for=condition=Ready pod/client -n network-lab --timeout=30s
kubectl rollout status deployment/web -n network-lab --timeout=30s
kubectl delete -f /root/deny-web.yaml
trap - EXIT
sleep 3
probe >/dev/null
echo 'PASS: cross-node Service traffic allowed, denied, restored.'
SCRIPT
""")


def reset_k8s(nodes):
    # These VMs are dedicated to this lab. Remove runtime images/state as well.
    boots = {name: remote(name, nodes, "cat /proc/sys/kernel/random/boot_id", capture=True).stdout.strip()
             for name in NAMES}
    for name in (*NAMES[1:], NAMES[0]):
        print(f"[{name}] Removing Kubernetes and container runtime state", flush=True)
        remote(name, nodes, """bash -se <<'SCRIPT'
if command -v kubeadm >/dev/null; then
  kubeadm reset -f --cri-socket unix:///run/containerd/containerd.sock
fi
systemctl stop kubelet containerd || true
packages=()
for package in kubelet kubeadm kubectl kubernetes-cni cri-tools containerd; do
  if dpkg-query -W -f='${db:Status-Status}' "$package" 2>/dev/null | grep -Eq '^(installed|config-files)$'; then
    packages+=("$package")
  fi
done
if [ "${#packages[@]}" -gt 0 ]; then
  apt-mark unhold "${packages[@]}" || true
  DEBIAN_FRONTEND=noninteractive apt-get purge -y "${packages[@]}"
fi
# /run contains Calico cgroup mounts; let reboot clear it, never rm through it.
rm -rf --one-file-system /etc/kubernetes /var/lib/etcd /var/lib/kubelet /etc/cni/net.d \
  /var/lib/cni /var/lib/calico /var/lib/containerd /etc/containerd /opt/cni/bin /root/.kube
rm -f /etc/default/kubelet /etc/sysctl.d/k8s.conf \
  /etc/apt/sources.list.d/kubernetes.list /etc/apt/keyrings/kubernetes-apt-keyring.gpg
# Reboot drops ephemeral CNI interfaces/routes and kube-proxy/Calico rules.
systemd-run --on-active=3s /usr/sbin/reboot
SCRIPT
""")
    # Require a new boot ID before allowing bootstrap to proceed.
    for name in NAMES:
        deadline = time.monotonic() + 300
        while True:
            result = remote(name, nodes, "cat /proc/sys/kernel/random/boot_id", capture=True, check=False)
            if result.returncode == 0 and result.stdout.strip() != boots[name]:
                break
            if time.monotonic() > deadline:
                sys.exit(f"{name} did not finish rebooting within 300 seconds")
            time.sleep(5)
    print("Kubernetes wiped; all three VMs rebooted. Run scripts/lab bootstrap.")


def main():
    sys.stdout.reconfigure(line_buffering=True)
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("command", choices=["import-existing", "plan", "infra", "up", "bootstrap",
                                            "ssh-config", "status", "demo", "policy-test", "destroy", "reset-k8s"])
    parser.add_argument("--yes", action="store_true", help="Explicitly skip apply/destroy/reset confirmation")
    args = parser.parse_args()
    os.umask(0o077)
    LOCAL.mkdir(mode=0o700, exist_ok=True)
    if args.command == "import-existing":
        adopt()
        configure_ssh(inventory())
        return
    if args.command in ("plan", "infra", "up", "destroy"):
        tf("init", "-input=false")
        if args.command == "plan":
            tf("plan")
            return
        if args.command == "destroy":
            # Terraform's interactive plan/confirmation is deliberately retained.
            tf("destroy", *(["-auto-approve"] if args.yes else []))
            print("Remaining lab servers and IPs (verify no lab leftovers):")
            run([HCLOUD, "server", "list"])
            run([HCLOUD, "primary-ip", "list"])
            return
        # Existing names outside state must be imported, not duplicated.
        tracked = tracked_resources()
        for server in cloud("server"):
            name = server["name"]
            if name in NAMES and f'hcloud_server.node["{name}"]' not in tracked:
                sys.exit("Existing lab is not tracked. Run scripts/lab import-existing first.")
        tf("apply", *(["-auto-approve"] if args.yes else []))
    nodes = inventory()
    configure_ssh(nodes)
    if args.command in ("bootstrap", "up"):
        bootstrap(nodes)
    elif args.command == "demo":
        demo(nodes)
    elif args.command == "policy-test":
        policy_test(nodes)
    elif args.command == "reset-k8s":
        if not args.yes and input("Erase all Kubernetes/runtime data on all three VMs? Type yes: ") != "yes":
            sys.exit("Cancelled")
        reset_k8s(nodes)
    elif args.command == "status":
        remote("k8s-cp", nodes, "export KUBECONFIG=/etc/kubernetes/admin.conf; kubectl get nodes -o wide && kubectl get pods -A && kubectl get tigerastatus")


if __name__ == "__main__":
    try:
        main()
    except subprocess.CalledProcessError as exc:
        # Do not print command/input: bootstrap commands can contain credentials.
        sys.exit(f"Command failed (exit {exc.returncode}); see output above. Fix and rerun the stage.")
    except KeyboardInterrupt:
        sys.exit(130)
